{
    "name": "wallee/magento-2",
    "description": "wallee integration for Magento 2",
    "keywords": [
        "wallee",
        "payment",
        "php",
        "magento",
        "magento2"
    ],
    "homepage": "https://www.wallee.com",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "wallee AG",
            "homepage": "https://www.wallee.com"
        }
    ],
    "type": "magento2-module",
    "version": "3.5.2",
    "require": {
        "php": "~7.4.0||~8.0||~8.1||~8.2||~8.3||~8.4",
        "magento/framework": "^102.0.0||^103.0.0",
        "wallee/plugin-core": "0.2.10"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Wallee\\Payment\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
